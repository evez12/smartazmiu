      "realmRoles": ["teacher"]
    },
    {
      "username": "elvin.quliyev",
      "email": "elvin.quliyev@smartazmiu.test",
      "emailVerified": true,
      "firstName": "Elvin",
      "lastName": "Quliyev",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["staff"]
    },
    {
      "username": "tural.babayev",
      "email": "tural.babayev@smartazmiu.test",
      "emailVerified": true,
      "firstName": "Tural",
      "lastName": "Babayev",
