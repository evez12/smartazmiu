      "emailVerified": true,
      "firstName": "Aysel",
      "lastName": "Məmmədova",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["student"]
    },
    {
      "username": "ramin.aliyev",
      "email": "ramin.aliyev@smartazmiu.test",
      "emailVerified": true,
      "firstName": "Ramin",
      "lastName": "Əliyev",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["student"]
    },
    {
