      "enabled": true,
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["student", "moderator"]
    },
    {
      "username": "leyla.hasanova",
      "email": "leyla.hasanova@smartazmiu.test",
