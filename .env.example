# Local development configuration. `make env` copies this file to `.env` and fills every
# value marked `generate` with a random secret. Never commit `.env`.

APP_ENV=development
LOG_LEVEL=INFO

# Postgres (host port 5433 avoids clashing with a native PostgreSQL service on 5432).
POSTGRES_USER=smartazmiu
POSTGRES_PASSWORD=generate
POSTGRES_DB=smartazmiu
POSTGRES_PORT=5433
# Redis A: web sessions and job queue (never evicts); Redis B: cache and rate limits (evicts, D-053).
REDIS_PORT=6379
REDIS_CACHE_PORT=6380

# S3-compatible object storage.
S3_ACCESS_KEY=smartazmiu
S3_SECRET_KEY=generate
S3_PORT=8333
# ClamAV scans chat attachments before anyone can download them.
CLAMAV_PORT=3310

# Keycloak (OIDC). OIDC_PUBLIC_URL is the URL browsers use; it is also the token issuer.
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=smartazmiu
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=generate
KEYCLOAK_TEST_USER_PASSWORD=generate
OIDC_PUBLIC_URL=http://localhost:8080
OIDC_CLIENT_ID=smartazmiu-web
OIDC_CLIENT_SECRET=generate
OIDC_AUDIENCE=smartazmiu-api
# Service account the API uses to assign realm roles (admin screen).
KEYCLOAK_ADMIN_CLIENT_SECRET=generate

# Web (BFF). APP_PUBLIC_URL is the full Docker stack behind nginx; WEB_DEV_URL is `make dev-web`.
APP_PUBLIC_URL=http://localhost
WEB_DEV_URL=http://localhost:3000
SESSION_SECRET=generate
DESIGN_SYSTEM_ENABLED=true
HTTP_PORT=80

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Notifications. E-mail goes to Mailpit locally; the Web Push (VAPID) key pair is derived from VAPID_SECRET,
# so changing it invalidates every browser's push subscription. TICKET_SECRET signs event tickets (QR codes).
MAIL_FROM=bildiris@smartazmiu.test
VAPID_SECRET=generate
VAPID_SUBJECT=mailto:it@smartazmiu.test
TICKET_SECRET=generate

# Leave empty to disable error reporting locally.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
